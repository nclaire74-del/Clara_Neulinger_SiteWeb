# ============================================
# SÉCURITÉ - Headers HTTP
# ============================================

# Content Security Policy - Protection contre XSS
<IfModule mod_headers.c>
    # CSP : Autoriser seulement les ressources du même domaine
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; object-src 'none'; frame-src 'self'; base-uri 'self'; form-action 'self';"
    
    # Protection contre le clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Empêcher le navigateur de deviner le type MIME
    Header set X-Content-Type-Options "nosniff"
    
    # Protection XSS intégrée du navigateur
    Header set X-XSS-Protection "1; mode=block"
    
    # Référrer Policy - Ne pas envoyer l'URL complète
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Forcer HTTPS (à activer en production)
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Permissions Policy - Limiter les APIs du navigateur
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# ============================================
# CACHE & PERFORMANCE
# ============================================

<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images - 1 an
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    
    # CSS et JavaScript - 1 mois
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # Fonts - 1 an
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # Vidéos - 1 mois
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType video/webm "access plus 1 month"
    
    # HTML - 1 heure
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ============================================
# COMPRESSION GZIP
# ============================================

<IfModule mod_deflate.c>
    # Compresser HTML, CSS, JavaScript, Texte, XML et fonts
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/xml application/xhtml+xml application/rss+xml application/atom_xml application/json font/ttf font/otf font/woff font/woff2 image/svg+xml
</IfModule>

# ============================================
# PROTECTION FICHIERS SENSIBLES
# ============================================

# Bloquer l'accès aux fichiers cachés (.git, .env, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Bloquer l'accès aux fichiers de configuration
<FilesMatch "\.(md|json|lock|yml|yaml|config)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ============================================
# ERREURS PERSONNALISÉES
# ============================================

# ErrorDocument 404 /404.html
# ErrorDocument 403 /403.html
# ErrorDocument 500 /500.html

# ============================================
# DÉSACTIVER LISTAGE RÉPERTOIRES
# ============================================

Options -Indexes

# ============================================
# REDIRECTIONS HTTPS (Production)
# ============================================

# Décommenter ces lignes en production pour forcer HTTPS
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>
